{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PULSO",
  "version": "0.1.0",
  "identifier": "org.pulso.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:desktop-ui",
    "devUrl": "http://localhost:5174/desktop.html",
    "beforeBuildCommand": "npm run build:desktop-ui",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PULSO",
        "url": "desktop.html",
        "width": 520,
        "height": 700,
        "minWidth": 460,
        "minHeight": 580,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
