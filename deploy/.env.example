# =============================================================================
# PULSO Servidor — Variáveis de Ambiente da Instância
# Copie este arquivo para `.env` antes de executar `docker compose`.
# =============================================================================

# --- Domínio e Proxy Reverso ---
# Obrigatório no perfil completo (`--profile full` com Caddy TLS automático):
PULSO_DOMAIN=pulso.exemplo.com

# Defina `true` quando a Instância estiver atrás de Caddy (`--profile full`) ou
# outro proxy reverso confiável para isolar o rate-limit em RAM por Participante.
# No perfil mínimo sem proxy reverso na frente, mantenha `false`.
TRUST_PROXY=true

# --- Rede e Bind do Servidor Node ---
HOST=0.0.0.0
PORT=3001
PULSO_BIND_PORT=3001
# PULSO_IMAGE=ghcr.io/pulso-app/pulso:latest

# --- STUN / TURN (Modo Normal — Chamada de Vídeo) ---
# Padrão quando omitido: servidores STUN públicos do Google. Defina vazio ("") para desativar STUN.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# URLs TURN entregues aos Participantes. No `--profile full`, aponte para seu domínio/IP público:
TURN_URLS=turn:pulso.exemplo.com:3478?transport=udp,turn:pulso.exemplo.com:3478?transport=tcp

# Segredo compartilhado entre `server/iceConfig.ts` e `coturn --use-auth-secret`.
# Gere com: openssl rand -hex 32
TURN_SECRET=troque-por-segredo-aleatorio-forte
TURN_TTL_SECONDS=3600
TURN_REALM=pulso.exemplo.com

# Alternativa estática (usada apenas se TURN_SECRET estiver vazio, ex.: TURN gerenciado):
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Detecção automática de IP externo no coturn (útil em VPS atrás de NAT 1:1):
DETECT_EXTERNAL_IP=yes
DETECT_RELAY_IP=yes

# --- Ciclo de Vida das Salas em RAM ---
# Contador de Inatividade em milissegundos (padrão: 3600000 = 1 hora)
PULSO_INACTIVITY_MS=3600000
# Janela de reconexão transitória em milissegundos (padrão: 30000 = 30 segundos)
PULSO_GRACE_WINDOW_MS=30000
# Limite máximo de Salas simultâneas em RAM na Instância (padrão: 1000)
PULSO_MAX_ROOMS=1000
