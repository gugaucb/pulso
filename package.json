{
  "name": "pulso-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && node scripts/build-server.mjs",
    "build:desktop-ui": "vite build --config vite.desktop.config.ts",
    "dev:desktop-ui": "vite --config vite.desktop.config.ts",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "package:desktop": "node scripts/package-desktop.mjs",
    "start": "node dist/server/index.js",
    "start:tor": "tsx server/torLauncher.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^11.0.0",
    "@fastify/websocket": "^11.3.7",
    "@fontsource/inter": "^5.2.0",
    "fastify": "^5.12.8",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "ws": "^8.23.0"
  }
}
